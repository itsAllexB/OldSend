<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- OldSend's background service (Settings > Run in Background). launchd runs it, and restarts
     it if it stops, only while the flag file exists; the app creates and removes that file. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lihaoyun6.oldsendd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/OldSend.app/OldSend</string>
		<string>--daemon</string>
	</array>
	<key>UserName</key>
	<string>mobile</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/var/mobile</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>PathState</key>
		<dict>
			<key>/var/mobile/Library/OldSend/daemon/enabled</key>
			<true/>
		</dict>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
</dict>
</plist>
